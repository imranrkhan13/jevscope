  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": { ".": { "types": "./src/index.d.ts", "default": "./src/index.js" } },
  "files": ["src", "README.md", "LICENSE"],
  "scripts": { "test": "node --test test/*.test.js" },
  "keywords": ["calibration", "confidence", "document extraction", "form filling", "human in the loop", "llm"],
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/imranrkhan13/jevscope" },
  "engines": { "node": ">=18" }
}
